{
  "name": "@axis-markets/client",
  "version": "0.8.2",
  "description": "AXIS contract and API client",
  "author": "team@stellar.expert",
  "license": "MIT",
  "type": "module",
  "types": "src/index.d.ts",
  "main": "lib/axis-client.cjs",
  "module": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./lib/axis-client.cjs"
    },
    "./footprint": {
      "types": "./src/footprint.d.ts",
      "import": "./src/footprint.js",
      "require": "./lib/footprint.cjs"
    },
    "./package.json": "./package.json"
  },
  "homepage": "https://axis.markets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axis-markets/js-client.git"
  },
  "bugs": "https://github.com/axis-markets/js-client/issues",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "webpack --mode=production --config webpack.config.cjs"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=17"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-loader": "10.1.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "files": [
    "src/",
    "lib/",
    "!src/cjs.js",
    "!src/footprint-cjs.js"
  ]
}
